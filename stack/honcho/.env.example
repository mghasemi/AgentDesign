# Honcho — persistent cross-session research memory.
# Live configuration: every model level is served by the local LM Studio instance.
# Copy to .env next to the Honcho source tree and fill in the keys.

# --- service ----------------------------------------------------------------
LOG_LEVEL=INFO
AUTH_USE_AUTH=false
HONCHO_BASE_URL=http://YOUR-HOST:8008
HONCHO_API_KEY=REPLACE_ME
GET_CONTEXT_MAX_TOKENS=24000

# --- storage ----------------------------------------------------------------
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false
EMBED_MESSAGES=true
EMBEDDING_VECTOR_DIMENSIONS=768

# DB_CONNECTION_URI and CACHE_URL are injected by docker-compose.yml.

# --- models (served locally) ------------------------------------------------
LM_STUDIO_BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1
LLM_OPENAI_API_KEY=REPLACE_ME

DERIVER_MODEL_CONFIG__MODEL=qwen3-8b
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=qwen3-8b
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=qwen3-8b
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=qwen3-8b
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=qwen3-8b
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=qwen3-8b
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=http://YOUR-INFERENCE-HOST:1234/v1

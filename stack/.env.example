# =============================================================================
# AgentDesign stack — environment template.
#
#   cp .env.example .env
#   # fill in every REPLACE_ME, then:  docker compose up -d
#
# .env is git-ignored. No credential is stored in docker-compose.yml.
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- layout -------------------------------------------------------------------
# Where the bind-mounted service data lives. Point this at the existing
# /opt/docker tree to reuse live data, or leave it as ./data for a fresh install.
STACK_DATA_DIR=./data
# Host uid/gid that should own the data (used by siyuan and lightrag)
PUID=1000
PGID=1000
UID=1000
GID=1000

# --- edge ---------------------------------------------------------------------
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
PORTAINER_PORT=9000

# --- notes (siyuan) -----------------------------------------------------------
SIYUAN_PORT=6806
SIYUAN_ACCESS_AUTH_CODE=REPLACE_ME

# --- task ledger (vikunja) ----------------------------------------------------
VIKUNJA_PORT=3456
VIKUNJA_PUBLIC_URL=http://YOUR-HOST:3456/
VIKUNJA_SERVICE_SECRET=REPLACE_ME
VIKUNJA_MAILER_ENABLED=false
VIKUNJA_MAILER_HOST=
VIKUNJA_MAILER_PORT=465
VIKUNJA_MAILER_USERNAME=
VIKUNJA_MAILER_PASSWORD=
VIKUNJA_MAILER_FROMEMAIL=

# --- federated search (searxng) ----------------------------------------------
SEARXNG_PORT=5050
SEARXNG_BASE_URL=http://YOUR-HOST:5050/
SEARXNG_SECRET=REPLACE_ME

# --- offline archives (zimi) --------------------------------------------------
ZIMI_PORT=8899
ZIMI_MANAGE_PASSWORD=REPLACE_ME

# --- graph-RAG (lightrag + neo4j + qdrant) ------------------------------------
LIGHTRAG_PORT=9621
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_ME
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- ingestion -----------------------------------------------------------------
PAPERFLOW_PORT=8000
PAPERFLOW_MAX_PAGES=600
PAPERFLOW_MAX_FILE_SIZE_MB=100
POCKETBASE_PORT=8090

# --- research memory (honcho) -------------------------------------------------
HONCHO_PORT=8008
HONCHO_DB_PORT=5433
HONCHO_REDIS_PORT=6379
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
# LightRAG — retrieval backend for the literature lake.
# Live configuration: OpenRouter for both LLM and embeddings, Neo4j for the graph,
# Qdrant for the vectors. Copy to .env and fill in the keys.

# --- LLM ----------------------------------------------------------------------
LLM_BINDING=openai
LLM_BINDING_HOST=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
LLM_API_KEY=REPLACE_ME

# --- embeddings ---------------------------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096
EMBEDDING_API_KEY=REPLACE_ME

# Some LightRAG code paths read the generic OpenAI variable
OPENAI_API_KEY=REPLACE_ME

# --- storage ------------------------------------------------------------------
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_ME
QDRANT_URL=http://qdrant:6333

# --- runtime ------------------------------------------------------------------
MAX_ASYNC=4
UID=1000
GID=1000
